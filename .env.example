# FUTO Central — environment variables
#
# Copy these into your Vercel project settings (and a local .env for
# development). No real value is committed here.

# --- Database ---------------------------------------------------------------
# Neon (or any Postgres) connection string used by lib/db.ts.
DATABASE_URL=

# --- Editorial news importer (app/api/import/news) --------------------------
# Base URL of the edu-news API, without a trailing slash.
EDU_NEWS_API_URL=
# Shared secret the cron calls the importer with. Send it as `x-import-secret`
# or `Authorization: Bearer <secret>`. Never in a query string.
IMPORT_SECRET=
# full = store the whole (moderated) story; truncated = stop at the nearest
# paragraph boundary at or before IMPORT_TRUNCATE_CHARS.
IMPORT_CONTENT_MODE=truncated
# Character budget used by truncated mode.
IMPORT_TRUNCATE_CHARS=1500
# Required. Comma separated edu-news SOURCE IDs (the API filters by id, not by
# name). When empty the importer imports nothing and returns a clear error.
IMPORT_SOURCE_ALLOWLIST=
# Case-insensitive regex of titles that must never be imported.
IMPORT_TITLE_BLOCKLIST=expo|runz|leaked|free answers
# Reject stories published more than this many days ago.
IMPORT_MAX_AGE_DAYS=10
# How many articles a single run may insert.
IMPORT_BATCH_SIZE=6
# Soft wall-clock budget for one run, in milliseconds.
IMPORT_TIME_BUDGET_MS=50000
# Maximum Cloudinary image uploads per article.
IMPORT_MAX_IMAGES=8
# "true" enables OneSignal pushes for imported stories. Anything else is silent.
IMPORT_NOTIFY=false
# Above this many fresh stories in one run, send one digest push instead.
IMPORT_NOTIFY_MAX_PER_RUN=3
# Only stories published within this many hours may trigger a push.
IMPORT_NOTIFY_MAX_AGE_HOURS=3

# --- Groq moderation -------------------------------------------------------
# OpenAI-compatible endpoint: https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Hard cap on the characters sent to the model per article. Text beyond this is
# never published.
GROQ_MAX_CHARS_TOTAL=8000
# Reject an article when the model wants to delete more than this share of its
# plain text blocks.
GROQ_MAX_REMOVE_RATIO=0.4
# closed = skip an article when moderation is unavailable (retried next run);
# open = import using the heuristic checks only.
GROQ_FAIL_MODE=closed
GROQ_TIMEOUT_MS=20000

# --- Cloudinary (already used by the editorial uploader) -------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OneSignal -------------------------------------------------------------
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
